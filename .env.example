# Puerto del servidor backend
PORT=3000

# Frecuencia de sincronización (expresión cron: cada 6 horas)
SYNC_CRON=0 */6 * * *

# Token de administración para POST /api/admin/sync
# ¡Cambiar en producción!
ADMIN_TOKEN=epiperu_admin_token_cambiar

# URL base del portal CKAN de datos abiertos del Perú
CKAN_BASE_URL=https://www.datosabiertos.gob.pe/api/3/action

# Habilitar capa climática Open-Meteo (true/false)
ENABLE_WEATHER=true

# Entorno de ejecución
NODE_ENV=development

# URL pública del frontend (para CORS en producción)
CLIENT_URL=http://localhost:5173
