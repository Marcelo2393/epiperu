  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/node-cron": "3.0.11",
    "@types/papaparse": "5.3.14",
    "supertest": "7.0.0",
